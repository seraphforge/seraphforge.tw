<%
  const homePath = String(page.path || '').replace(/index\.html$/, '').replace(/\/$/, '');
  const isEnglishHome = homePath === 'en' || String(page.site_lang || '').toLowerCase() === 'en';
  const copy = isEnglishHome ? {
    lang: 'en', hero: 'Build and document research and engineering work across security, systems, embedded platforms, and Medical IoT.',
    researchLabel: 'Current Research', question: 'After a Gateway receives Medical IoT data, what can we actually trust?',
    systemsLabel: 'Selected Systems', systemsTitle: 'Systems', journalLabel: 'Latest Journal', journalTitle: 'Journal', nowLabel: 'Now / Current', nowHeading: 'Current research and engineering directions', current: 'Current', viewSystem: 'View system', researchTitle: 'Research', allJournal: 'View all journal entries', researchLink: 'Research question', systemLink: 'Open system', usesLink: 'Technical environment', archiveLink: 'Past work',
    medtrustBody: 'The primary Medical IoT trust and evidence validation system.', labBody: 'Infrastructure for research, deployment experiments, and recovery practice.',
    medtrustTags: ['ESP32-S3','FastAPI','HMAC','Replay Protection'], labTags: ['Ubuntu Server','Docker','OpenWrt','Tailscale'],
    nowItems: [
      { title: 'Medical IoT Trust', description: 'Validating what a Gateway can trust after device data arrives.', meta: ['PRIMARY RESEARCH', 'CURRENT'] },
      { title: 'Embedded Security', description: 'Examining trust at the device and message boundary.', meta: ['ENGINEERING', 'ACTIVE'] },
      { title: 'ROS 2 Jazzy', description: 'Learning distributed robotics communication and integration.', meta: ['EXPLORING'] }
    ]
  } : {
    lang: 'zh-Hant', hero: '建置並記錄資訊安全、系統、嵌入式與醫療 IoT 相關的研究與工程實作。',
    researchLabel: '目前研究', question: '當 Gateway 收到醫療 IoT 裝置資料後，我們究竟可以相信什麼？',
    systemsLabel: '精選系統', systemsTitle: '系統', journalLabel: '最新筆記', journalTitle: '研究筆記', nowLabel: '目前進度', nowHeading: '目前正在進行的研究與工程方向', current: '目前', viewSystem: '查看系統', researchTitle: '研究', allJournal: '查看全部研究筆記', researchLink: '研究問題', systemLink: '開啟系統', usesLink: '技術環境', archiveLink: '過往工作',
    medtrustBody: '目前主要的 Medical IoT 信任與證據驗證系統。', labBody: '支撐研究、部署實驗與復原練習的基礎設施。',
    medtrustTags: ['ESP32-S3','FastAPI','HMAC','Replay Protection'], labTags: ['Ubuntu Server','Docker','OpenWrt','Tailscale'],
    nowItems: [
      { title: 'Medical IoT 信任', description: '驗證醫療裝置資料抵達 Gateway 後，哪些資訊值得信任。', meta: ['主要研究', '目前'] },
      { title: '嵌入式資安', description: '持續檢查裝置端與訊息邊界的信任問題。', meta: ['工程', '進行中'] },
      { title: 'ROS 2 Jazzy', description: '探索分散式機器人通訊與系統整合。', meta: ['探索中'] }
    ]
  };
  const latestPosts = site.posts.toArray().filter(post => {
    if (post.draft === true || post.hidden === true || post.published === false) return false;
    return isEnglishHome ? String(post.site_lang || post.lang || '').toLowerCase() === 'en' : String(post.site_lang || post.lang || '').toLowerCase() !== 'en';
  }).slice(0, 4);
  const taxonomy = post => { const c = post.categories && post.categories.toArray ? post.categories.toArray() : []; const t = post.tags && post.tags.toArray ? post.tags.toArray() : []; return (c[0] && c[0].name) || (t[0] && t[0].name) || (isEnglishHome ? 'Notes' : '筆記'); };
  const excerpt = post => strip_html(post.description || post.excerpt || post.content || '').replace(/\s+/g, ' ').trim().slice(0, 150);
%>
<section class="entry-home seraph-current-home" lang="<%= copy.lang %>">
  <section class="entry-home-hero" aria-labelledby="seraph-home-title"><div class="entry-home-hero__copy"><p class="entry-home-eyebrow"><%= isEnglishHome ? 'RYVÆN / RESEARCH + ENGINEERING' : 'RYVÆN／研究與工程' %></p><h1 id="seraph-home-title"><%= isEnglishHome ? 'Security × Systems × Embedded × Medical IoT' : '資安 × 系統 × 嵌入式 × Medical IoT' %></h1><p class="entry-home-hero__summary"><%= copy.hero %></p><div class="entry-home-hero__actions"><a class="os-button os-button-primary" href="<%= url_for(isEnglishHome ? '/en/research/' : '/research/') %>"><%= copy.researchLink %></a><a class="os-button os-button-secondary" href="<%= url_for(isEnglishHome ? '/en/systems/' : '/systems/') %>"><%= copy.systemLink %></a></div></div></section>
  <section class="entry-home-section entry-home-research"><header class="entry-home-section__header"><p class="entry-home-eyebrow"><%= copy.researchLabel %></p><h2>MedTrust</h2><p class="entry-home-subtitle"><%= isEnglishHome ? 'Medical IoT Trust & Evidence System' : 'Medical IoT 信任與證據系統' %></p><p class="entry-home-question"><%= copy.question %></p></header><ul class="entry-home-tag-list"><% copy.medtrustTags.forEach(tag => { %><li><%= tag %></li><% }) %></ul><div class="entry-home-inline-links"><a class="entry-home-more-link" href="<%= url_for(isEnglishHome ? '/en/research/' : '/research/') %>"><%= copy.researchTitle %> →</a><a class="entry-home-more-link" href="<%= url_for(isEnglishHome ? '/en/systems/medtrust/' : '/systems/medtrust/') %>">MedTrust →</a></div></section>
  <section class="entry-home-section"><header class="entry-home-section__header"><p class="entry-home-eyebrow"><%= copy.systemsLabel %></p><h2><%= copy.systemsTitle %></h2></header><div class="entry-home-system-grid"><article class="entry-home-system-card"><div class="entry-home-card__meta"><span><%= copy.current %></span></div><h3>MedTrust</h3><p><%= copy.medtrustBody %></p><ul class="entry-home-tag-list"><% copy.medtrustTags.forEach(tag => { %><li><%= tag %></li><% }) %></ul><a class="entry-home-link" href="<%= url_for(isEnglishHome ? '/en/systems/medtrust/' : '/systems/medtrust/') %>"><%= copy.viewSystem %> →</a></article><article class="entry-home-system-card"><div class="entry-home-card__meta"><span><%= copy.current %></span></div><h3>Home Lab</h3><p><%= copy.labBody %></p><ul class="entry-home-tag-list"><% copy.labTags.forEach(tag => { %><li><%= tag %></li><% }) %></ul><a class="entry-home-link" href="<%= url_for(isEnglishHome ? '/en/systems/home-lab/' : '/systems/home-lab/') %>"><%= copy.viewSystem %> →</a></article></div></section>
  <section class="entry-home-section"><header class="entry-home-section__header"><p class="entry-home-eyebrow"><%= copy.journalLabel %></p><h2><%= copy.journalTitle %></h2></header><div class="entry-home-writing-list"><% latestPosts.forEach(post => { const summary = excerpt(post); %><article class="entry-home-writing-item"><div class="entry-home-card__meta"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time><span><%= taxonomy(post) %></span></div><div><h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3><p><%= summary %><%= summary.length >= 150 ? '…' : '' %></p></div></article><% }) %></div><a class="entry-home-more-link" href="<%= url_for(isEnglishHome ? '/en/journal/' : '/journal/') %>"><%= copy.allJournal %> →</a></section>
  <section class="entry-home-section entry-home-now" aria-labelledby="seraph-now-title"><header class="entry-home-section__header entry-home-now__header"><p class="entry-home-eyebrow"><%= copy.nowLabel %></p><h2 id="seraph-now-title"><%= copy.nowHeading %></h2></header><ol class="entry-home-now__list"><% copy.nowItems.forEach((item, index) => { %><li class="entry-home-now__item<%= index === 0 ? ' entry-home-now__item--primary' : '' %>"><span class="entry-home-now__number">0<%= index + 1 %></span><div class="entry-home-now__body"><h3><%= item.title %></h3><p><%= item.description %></p></div><div class="entry-home-now__meta"><% item.meta.forEach(value => { %><span><%= value %></span><% }) %></div></li><% }) %></ol></section>
</section>
