<%
  const htmlPath = String(page.path || '').replace(/index\.html$/, '').replace(/\/$/, '');
  const htmlParts = htmlPath.split('/').filter(Boolean);
  const normalizeHtmlLang = function(value) {
    const normalized = String(value || '').toLowerCase();
    if (normalized === 'zh' || normalized === 'zh-tw' || normalized === 'zh-hant') return 'zh-Hant';
    if (normalized === 'en') return 'en';
    return '';
  };
  const explicitHtmlLang = htmlParts[0] === 'zh' ? 'zh-Hant' : (htmlParts[0] === 'en' ? 'en' : '');
  const htmlLang = explicitHtmlLang || normalizeHtmlLang(page.site_lang) || 'en';
  const localHtmlParts = explicitHtmlLang ? htmlParts.slice(1) : htmlParts;
  const isProjectDetailPage = String(page.type || '').toLowerCase() === 'project' || (localHtmlParts[0] === 'projects' && localHtmlParts.length === 2);
  const isPostPage = page.layout === 'post';
%>
<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <%- partial('_partial/head') %>
</head>
<body>
  <div class="site-wrapper">
    <%- partial('_partial/header') %>

    <main class="main-container<%= isProjectDetailPage ? ' project-detail-page' : '' %><%= isPostPage ? ' post-page' : '' %>">
      <%- body %>
    </main>

    <%- partial('_partial/footer') %>
  </div>
  <script>
    (function() {
      var copyButtons = Array.prototype.slice.call(document.querySelectorAll('[data-copy-email]'));
      copyButtons.forEach(function(button) {
        var originalText = button.textContent;
        button.addEventListener('click', function() {
          var email = button.getAttribute('data-copy-email') || '';
          var status = button.parentElement ? button.parentElement.querySelector('[data-copy-email-status]') : null;
          if (!email || !navigator.clipboard || !navigator.clipboard.writeText) return;
          navigator.clipboard.writeText(email).then(function() {
            var isZh = document.documentElement.lang === 'zh-Hant';
            button.textContent = isZh ? '已複製' : 'Copied';
            if (status) status.textContent = isZh ? '已複製' : 'Copied';
            window.setTimeout(function() {
              button.textContent = originalText;
              if (status) status.textContent = '';
            }, 1800);
          }).catch(function() {
            return;
          });
        });
      });
    })();
  </script>
</body>
</html>
