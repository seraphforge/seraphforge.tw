<% function renderStatusBadge(status) {
  const positiveStatuses = ['Ongoing', 'Current', 'Public', 'Applied', 'Integrated', 'Completed', 'Working Prototype'];
  const warningStatuses = ['Planning', 'Planned', 'In Progress', 'Learning', 'Exploring'];
  const tone = positiveStatuses.indexOf(status) >= 0 ? 'good' : (warningStatuses.indexOf(status) >= 0 ? 'warn' : 'neutral');
%>
  <span class="research-status-badge" data-status-tone="<%= tone %>"><%= statusLabel(status) %></span>
<% } %>

<% function renderMetadataList(items) { %>
  <dl class="research-metadata-list">
    <% items.filter(function(item) { return item[1] || item[1] === 0; }).forEach(function(item) { %>
      <div><dt><%= item[0] %></dt><dd><%- item[1] %></dd></div>
    <% }) %>
  </dl>
<% } %>

<% function renderTagList(items) { %>
  <div class="research-tag-list">
    <% (items || []).forEach(function(item) { %><span><%= item %></span><% }) %>
  </div>
<% } %>

<% function renderArchitectureSnapshot(project) { const architecture = project.architecture || {}; const nodes = architecture.nodes || []; %>
  <% if (nodes.length) { %>
    <div class="architecture-snapshot" aria-label="Architecture snapshot">
      <div class="architecture-flow">
        <% nodes.forEach(function(node, index) { %>
          <div class="architecture-node">
            <span><%= node.type %></span>
            <strong><%= node.label %></strong>
          </div>
          <% if (index < nodes.length - 1) { %><span class="architecture-arrow" aria-hidden="true">&rarr;</span><% } %>
        <% }) %>
      </div>
      <% if ((architecture.security || []).length) { %>
        <div class="architecture-security">
          <span>Security</span>
          <% renderTagList(architecture.security); %>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <p class="research-empty-state"><%= isZh ? 'Architecture content being organized.' : 'Architecture content being organized.' %></p>
  <% } %>
<% } %>

<% function localizedField(item, key) {
  return maybeZh(item, key);
} %>

<% function homeSystemTitle(project) {
  return localizedField(project, 'homeTitle') || localizedField(project, 'title');
} %>

<% function homeSystemSummary(project) {
  return localizedField(project, 'summary') || localizedField(project, 'description') || localizedField(project, 'problem');
} %>

<% function listingSummary(project) {
  const value = localizedField(project, 'listingSummary') || localizedField(project, 'summary') || localizedField(project, 'approach');
  if (Array.isArray(value)) return value;
  return String(value || '').split(/\n+/).map(function(line) { return line.trim(); }).filter(Boolean);
} %>

<% function systemCardTags(project) {
  return safeArray(project.listingTags || project.technologies).slice(0, 5);
} %>

<%
