<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<%
  const siteTitle = config.title || '';
  const metaTitle = page.title ? page.title + ' — ' + siteTitle : siteTitle;
  const rawDescription = page.description || page.excerpt || page.content || config.description || '';
  const metaDescription = (strip_html(rawDescription).replace(/\s+/g, ' ').trim() || config.description || '').slice(0, 160);
  const metaKeywords = Array.isArray(page.keywords) ? page.keywords.join(', ') : (page.keywords || config.keywords || '');
  const baseUrl = (config.url || '').replace(/\/$/, '');
  const rootPath = config.root || '/';
  const absoluteUrl = function(path) {
    if (/^https?:\/\//.test(path)) return path;
    let localPath = url_for(path).replace(/index\.html$/, '');
    if (rootPath !== '/' && localPath.indexOf(rootPath) === 0) {
      localPath = localPath.slice(rootPath.length - 1);
    }
    return baseUrl + localPath;
  };
  const canonicalInput = String(page.canonical_url || '');
  const normalizedCanonicalInput = canonicalInput.replace(/^https?:\/\/seraphforge\.github\.io(?=\/)/, '');
  const canonicalUrl = normalizedCanonicalInput ? absoluteUrl(normalizedCanonicalInput) : absoluteUrl(page.path || '/');
  const canonicalAbsoluteUrl = function(path) {
    return absoluteUrl(path);
  };
  const hasShareImage = Boolean(page.cover);
  const shareImage = hasShareImage ? absoluteUrl(page.cover) : '';
  const shareImageAlt = page.title ? page.title + ' preview image' : siteTitle + ' preview image';
  const metaType = page.layout === 'post' ? 'article' : 'website';
  const shouldIndexPage = page.layout === 'post' ? seraph_should_index_post(page) : page.indexing !== false;
  const headPath = String(page.path || '').replace(/index\.html$/, '').replace(/\/$/, '');
  const headParts = headPath.split('/').filter(Boolean);
  const normalizeHeadLang = function(value) {
    const normalized = String(value || '').toLowerCase();
    if (normalized === 'zh' || normalized === 'zh-tw' || normalized === 'zh-hant') return 'zh';
    if (normalized === 'en') return 'en';
    return '';
  };
  const explicitHeadLang = ['en', 'zh'].includes(headParts[0]) ? headParts[0] : '';
  const headLang = explicitHeadLang || normalizeHeadLang(page.site_lang) || normalizeHeadLang(config.language) || 'zh';
  const ogLocales = { en: 'en_US', zh: 'zh_TW' };
  const localHeadParts = explicitHeadLang ? headParts.slice(1) : headParts;
  const firstHeadPart = localHeadParts[0] || '';
  const localHeadPath = localHeadParts.join('/');
  const isDatedHeadPost = /^\d{4}\/\d{2}\/\d{2}\//.test(localHeadPath);
  const headSection =
    firstHeadPart === '' ? 'home' :
    firstHeadPart === 'dashboard' ? 'dashboard' :
    firstHeadPart === 'works' ? 'projects' :
    firstHeadPart === 'archives' ? 'writing' :
    ['about', 'experience', 'systems', 'projects', 'outcomes', 'now', 'labs', 'writing', 'timeline', 'research', 'journal', 'uses', 'archive'].includes(firstHeadPart) && localHeadParts.length === 1 ? firstHeadPart :
    null;
  const trilingualDetailPaths = [
    'experience/awards',
    'experience/workshops',
    'experience/speaking',
    'experience/community',
    'experience/ctf',
    'experience/projects',
    'experience/research',
    'experience/certifications',
    'projects/nihs-control-team',
    'projects/medical-cybersecurity',
    'projects/autonomous-robot',
    'systems/securecare',
    'systems/securecare-platform',
    'systems/home-lab-infrastructure',
    'labs/esp32-uart-test',
    'labs/ros2-topic-communication',
    'labs/web-security',
    'labs/medical-cybersecurity-research',
    'labs/ctf-web-practice'
  ];
  const detailHreflangPaths = trilingualDetailPaths.includes(localHeadPath) ? {
    en: '/' + localHeadPath + '/',
    zh: '/zh/' + localHeadPath + '/'
  } : null;
  const postHreflangPaths = isDatedHeadPost ? {
    en: '/' + localHeadPath + '/',
    zh: '/zh/' + localHeadPath + '/'
  } : null;
  const sectionHreflangPaths = headSection ? {
    home: { en: '/', zh: '/zh/' },
    dashboard: { en: '/dashboard/', zh: '/zh/dashboard/' },
    about: { en: '/about/', zh: '/zh/about/' },
    experience: { en: '/en/experience/', zh: '/experience/' },
    systems: { en: '/systems/', zh: '/zh/systems/' },
    projects: { en: '/projects/', zh: '/zh/projects/' },
    outcomes: { en: '/outcomes/', zh: '/zh/outcomes/' },
    now: { en: '/now/', zh: '/zh/now/' },
    labs: { en: '/labs/', zh: '/zh/labs/' },
    writing: { en: '/writing/', zh: '/zh/writing/' },
    timeline: { en: '/timeline/', zh: '/zh/timeline/' },
    research: { en: '/en/research/', zh: '/research/' },
    journal: { en: '/en/journal/', zh: '/journal/' },
    uses: { en: '/en/uses/', zh: '/uses/' },
    archive: { en: '/en/archive/', zh: '/archive/' }
  }[headSection] : null;
  const hreflangPaths = detailHreflangPaths || postHreflangPaths || sectionHreflangPaths;
%>

<title><%= metaTitle %></title>
<meta name="description" content="<%= metaDescription %>">
<% if (!shouldIndexPage) { %><meta name="robots" content="noindex, nofollow"><% } %>
<% if (metaKeywords) { %><meta name="keywords" content="<%= metaKeywords %>"><% } %>
<meta name="author" content="<%= config.author || '' %>">
<link rel="canonical" href="<%= canonicalUrl %>">
<% if (hreflangPaths) { %>
<link rel="alternate" hreflang="en" href="<%= canonicalAbsoluteUrl(hreflangPaths.en) %>">
<link rel="alternate" hreflang="zh-TW" href="<%= canonicalAbsoluteUrl(hreflangPaths.zh) %>">
<link rel="alternate" hreflang="x-default" href="<%= canonicalAbsoluteUrl(hreflangPaths.en) %>">
<% } %>

<meta property="og:site_name" content="<%= siteTitle %>">
<meta property="og:title" content="<%= metaTitle %>">
<meta property="og:description" content="<%= metaDescription %>">
<meta property="og:type" content="<%= metaType %>">
<meta property="og:url" content="<%= canonicalUrl %>">
<% if (hasShareImage) { %>
<meta property="og:image" content="<%= shareImage %>">
<meta property="og:image:alt" content="<%= shareImageAlt %>">
<% } %>
<meta property="og:locale" content="<%= ogLocales[headLang] %>">
<% if (page.date) { %>
<meta property="article:published_time" content="<%= date_xml(page.date) %>">
<% } %>
<% if (page.updated) { %>
<meta property="article:modified_time" content="<%= date_xml(page.updated) %>">
<% } %>

<meta name="twitter:card" content="<%= hasShareImage ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= metaTitle %>">
<meta name="twitter:description" content="<%= metaDescription %>">
<% if (hasShareImage) { %>
<meta name="twitter:image" content="<%= shareImage %>">
<meta name="twitter:image:alt" content="<%= shareImageAlt %>">
<% } %>

<link rel="icon" type="image/svg+xml" href="<%= url_for('/favicon.svg') %>">
<link rel="shortcut icon" href="<%= url_for('/favicon.svg') %>">
<link rel="stylesheet" href="<%= url_for('/css/custom.css') %>?v=23">
