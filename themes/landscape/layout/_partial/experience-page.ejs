<%
  const expPath = String(page.path || '').replace(/index\.html$/, '').replace(/\/$/, '');
  const expParts = expPath.split('/').filter(Boolean);
  const expLang = expParts[0] === 'en' ? 'en' : 'zh';
  const isExpZh = expLang === 'zh';
  const expData = ((site.data && site.data.experience) || {})[expLang] || {};
  const expSections = expData.sections || {};
  const safeArray = function(value) {
    if (Array.isArray(value)) return value.filter(Boolean);
    return value ? [value] : [];
  };
  const collectSectionItems = function(section) {
    if (!section) return [];
    if (Array.isArray(section.groups)) {
      return section.groups.reduce(function(rows, group) {
        return rows.concat(safeArray(group.items).map(function(item) {
          return Object.assign({ groupYear: group.year }, item);
        }));
      }, []);
    }
    return safeArray(section.items);
  };
  const itemYear = function(item) { return item.year || item.groupYear || ''; };
  const itemName = function(item) { return isExpZh ? (item.nameZh || item.name) : (item.name || item.nameZh); };
  const itemRole = function(item) { return isExpZh ? (item.roleZh || item.role || '') : (item.role || ''); };
  const itemResults = function(item) { return safeArray(isExpZh && item.resultZh ? item.resultZh : item.result); };
  const sortRecords = function(items) {
    return items.slice().sort(function(a, b) { return String(itemYear(b)).localeCompare(String(itemYear(a))); });
  };
  const competitionItems = sortRecords(collectSectionItems(expSections.competitions));
  const competitionTypes = [
    { title: isExpZh ? '資安競賽' : 'Cybersecurity competitions', test: /CTF|Cybersecurity|Cryptography|Hackathon/i },
    { title: isExpZh ? '機器人競賽' : 'Robotics competitions', test: /Robotics|FRC|FTC|MARC/i },
    { title: isExpZh ? '其他技術競賽' : 'Other technical competitions', test: null }
  ];
  const competitionGroups = competitionTypes.map(function(type, index) {
    return {
      title: type.title,
      items: competitionItems.filter(function(item) {
        const tags = safeArray(item.tags).join(' ');
        const earlier = competitionTypes.slice(0, index).some(function(previous) { return previous.test && previous.test.test(tags); });
        return !earlier && (!type.test || type.test.test(tags));
      })
    };
  }).filter(function(group) { return group.items.length; });
  const sections = [
    { key: 'camps', title: isExpZh ? '營隊' : 'Camps' },
    { key: 'conferences', title: isExpZh ? '研討會與年會' : 'Conferences' },
    { key: 'workshops', title: isExpZh ? '工作坊' : 'Workshops' },
    { key: 'certifications', title: isExpZh ? '證照' : 'Certifications' }
  ].map(function(section) {
    return Object.assign({}, section, { items: sortRecords(collectSectionItems(expSections[section.key])) });
  }).filter(function(section) { return section.items.length; });
%>

<% function renderRecordList(items, label) { %>
  <ol class="series-article-list" aria-label="<%= label %>">
    <% items.forEach(function(item) {
      const details = [itemRole(item)].concat(itemResults(item)).filter(Boolean);
    %>
      <li class="series-article-item">
        <div class="series-article-number"><%= itemYear(item) %></div>
        <div class="series-article-body">
          <h3><%= itemName(item) %></h3>
          <% if (details.length) { %><p><%= details.join(isExpZh ? '／' : ' / ') %></p><% } %>
        </div>
      </li>
    <% }) %>
  </ol>
<% } %>

<article class="research-page experience-page" lang="<%= isExpZh ? 'zh-Hant' : 'en' %>">
  <header class="research-page-header">
    <p class="research-section-kicker"><%= isExpZh ? '經歷' : 'Experience' %></p>
    <h1><%= isExpZh ? '經歷' : 'Experience' %></h1>
    <p><%= isExpZh ? '整理我參與過的競賽、營隊、研討會、工作坊與取得的證照。' : 'A simple record of competitions, camps, conferences, workshops, and certifications I have taken part in.' %></p>
  </header>

  <section class="research-page-section" aria-labelledby="experience-competitions-title">
    <header class="research-section-header"><p class="research-section-kicker"><%= isExpZh ? '參與紀錄' : 'Participation' %></p><h2 id="experience-competitions-title"><%= isExpZh ? '競賽' : 'Competitions' %></h2></header>
    <% competitionGroups.forEach(function(group) { %>
      <section class="series-index"><h3><%= group.title %></h3><% renderRecordList(group.items, group.title); %></section>
    <% }) %>
  </section>

  <% sections.forEach(function(section) { %>
    <section class="research-page-section" aria-labelledby="experience-<%= section.key %>-title">
      <header class="research-section-header"><h2 id="experience-<%= section.key %>-title"><%= section.title %></h2></header>
      <% renderRecordList(section.items, section.title); %>
    </section>
  <% }) %>
</article>
