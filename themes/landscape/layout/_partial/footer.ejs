<%
  const footerPath = String(page.path || '').replace(/index\.html$/, '').replace(/\/$/, '');
  const footerParts = footerPath.split('/').filter(Boolean);
  const footerLang = footerParts[0] === 'en' ? 'en' : 'zh';
  const footerCopy = {
    zh: {
      label: '頁尾',
      title: 'RYVÆN',
      note: 'Security / Embedded / Infrastructure.',
      home: '首頁',
      research: '研究方向',
      systems: '工程系統',
      journal: '研究筆記',
      archive: '結案紀錄',
      about: '關於',
      updated: 'Last updated'
    },
    en: {
      label: 'Site footer',
      title: 'RYVÆN',
      note: 'Security / Embedded / Infrastructure.',
      home: 'Home',
      research: 'Research',
      systems: 'Systems',
      journal: 'Journal',
      archive: 'Archive',
      about: 'About',
      updated: 'Last updated'
    }
  }[footerLang];
  const pathFor = function(path) {
    return footerLang === 'en' ? '/en' + path : path;
  };
%>
<footer id="contact" class="site-footer polaris-footer" aria-label="<%= footerCopy.label %>">
  <p class="polaris-footer-title"><%= footerCopy.title %></p>
  <p class="polaris-footer-note"><%= footerCopy.note %></p>
  <nav class="footer-links" aria-label="<%= footerCopy.label %>">
    <a href="<%= url_for(pathFor('/')) %>"><%= footerCopy.home %></a>
    <a href="<%= url_for(pathFor('/research/')) %>"><%= footerCopy.research %></a>
    <a href="<%= url_for(pathFor('/systems/')) %>"><%= footerCopy.systems %></a>
    <a href="<%= url_for(pathFor('/journal/')) %>"><%= footerCopy.journal %></a>
    <a href="<%= url_for(pathFor('/archive/')) %>"><%= footerCopy.archive %></a>
    <a href="<%= url_for(pathFor('/about/')) %>"><%= footerCopy.about %></a>
  </nav>
  <p class="footer-copy"><%= footerCopy.updated %>: 2026-08 / &copy; 2026 RYVÆN.</p>
</footer>
