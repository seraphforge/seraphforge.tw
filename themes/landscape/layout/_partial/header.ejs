<%
  const normalizedPath = String(page.path || '').replace(/index\.html$/, '').replace(/\/$/, '');
  const pathParts = normalizedPath.split('/').filter(Boolean);
  const urlLang = pathParts[0] === 'en' ? 'en' : (pathParts[0] === 'zh' ? 'zh' : '');
  const currentLang = urlLang === 'en' ? 'en' : 'zh';
  const localPathParts = urlLang ? pathParts.slice(1) : pathParts;
  const localDetailPath = localPathParts.join('/');
  const currentSection = (function() {
    if (!localPathParts.length) return 'home';
    if (localPathParts[0] === 'research') return 'research';
    if (localPathParts[0] === 'systems') return 'systems';
    if (localPathParts[0] === 'journal' || localPathParts[0] === 'writing') return 'journal';
    if (localPathParts[0] === 'archive' || localPathParts[0] === 'archives' || localPathParts[0] === 'outcomes' || localPathParts[0] === 'timeline') return 'archive';
    if (localPathParts[0] === 'about') return 'profile';
    return '';
  })();
  const localizedPaths = {
    zh: { home: '/', research: '/research/', systems: '/systems/', journal: '/journal/', archive: '/archive/', profile: '/about/' },
    en: { home: '/en/', research: '/en/research/', systems: '/en/systems/', journal: '/en/journal/', archive: '/en/archive/', profile: '/en/about/' }
  };
  const labels = {
    zh: {
      home: '首頁',
      research: '研究方向',
      systems: '工程系統',
      journal: '研究筆記',
      archive: '結案紀錄',
      profile: '關於',
      menu: '選單',
      language: '語言',
      navigation: '主導覽',
      appearance: '外觀',
      light: 'Light',
      dark: 'Dark',
      toggleTheme: '切換顯示模式'
    },
    en: {
      home: 'Home',
      research: 'Research',
      systems: 'Systems',
      journal: 'Journal',
      archive: 'Archive',
      profile: 'About',
      menu: 'Menu',
      language: 'Language',
      navigation: 'Navigation',
      appearance: 'Appearance',
      light: 'Light',
      dark: 'Dark',
      toggleTheme: 'Toggle display theme'
    }
  };
  const navPath = function(key) {
    const paths = localizedPaths[currentLang] || localizedPaths.zh;
    return paths[key] || paths.home;
  };
  const langPath = function(targetLang) {
    const corePaths = ['', 'research', 'systems', 'systems/medtrust', 'systems/home-lab', 'journal', 'archive', 'about'];
    const seriesPaths = ['journal/series', 'journal/series/medtrust', 'journal/series/medtrust/00'];
    if (targetLang === 'en') {
      if (corePaths.indexOf(localDetailPath) >= 0) return '/en' + (localDetailPath ? '/' + localDetailPath : '') + '/';
      if (seriesPaths.indexOf(localDetailPath) >= 0) return '/en/journal/';
      return '/en/';
    }
    if (corePaths.indexOf(localDetailPath) >= 0) return '/' + (localDetailPath ? localDetailPath + '/' : '');
    if (seriesPaths.indexOf(localDetailPath) >= 0) return '/journal/';
    return '/';
  };
  const h = labels[currentLang] || labels.zh;
  const navItems = [
    { key: 'home', label: h.home },
    { key: 'research', label: h.research },
    { key: 'systems', label: h.systems },
    { key: 'journal', label: h.journal },
    { key: 'archive', label: h.archive },
    { key: 'profile', label: h.profile }
  ];
  const renderNavLink = function(item, index) {
    const active = currentSection === item.key ? ' aria-current="page"' : '';
    return '<a class="nav-item" href="' + url_for(navPath(item.key)) + '"' + active + '><span class="nav-item__index">' + String(index + 1).padStart(2, '0') + '</span><span class="nav-item__label">' + item.label + '</span></a>';
  };
  const renderLanguageSwitcher = function(className) {
    return '<nav class="' + className + '" aria-label="' + h.language + '">' +
      '<a class="language-option' + (currentLang === 'zh' ? ' is-active' : '') + '" href="' + url_for(langPath('zh')) + '" lang="zh-Hant"' + (currentLang === 'zh' ? ' aria-current="page"' : '') + '>繁中</a>' +
      '<a class="language-option' + (currentLang === 'en' ? ' is-active' : '') + '" href="' + url_for(langPath('en')) + '" lang="en"' + (currentLang === 'en' ? ' aria-current="page"' : '') + '>EN</a>' +
    '</nav>';
  };
%>
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="<%= url_for(navPath('home')) %>" aria-label="Seraph">
      <span class="site-brand__text">
        <strong>SERAPH</strong>
        <small>Security / Embedded / Infrastructure</small>
      </span>
    </a>

    <nav class="site-navigation" aria-label="<%= h.navigation %>">
      <% navItems.forEach(function(item, index) { %><%- renderNavLink(item, index) %><% }); %>
    </nav>

    <div class="site-header__actions">
      <%- renderLanguageSwitcher('language-switcher') %>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="<%= h.toggleTheme %>" aria-pressed="false">
        <span class="theme-toggle__icon" aria-hidden="true"></span>
        <span class="theme-toggle__label">
          <small>Theme</small>
          <strong data-theme-label><%= h.dark %></strong>
        </span>
      </button>
    </div>

    <button class="mobile-menu-button" type="button" aria-controls="mobile-nav" aria-expanded="false">
      <span class="mobile-menu-label"><%= h.menu %></span>
      <span class="mobile-menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
    <section class="mobile-nav-section" aria-labelledby="mobile-nav-navigation-label">
      <p id="mobile-nav-navigation-label" class="mobile-nav-label"><%= h.navigation %></p>
      <div class="mobile-nav-links">
        <% navItems.forEach(function(item, index) { %><%- renderNavLink(item, index) %><% }); %>
      </div>
    </section>
    <section class="mobile-nav-section" aria-labelledby="mobile-nav-language-label">
      <p id="mobile-nav-language-label" class="mobile-nav-label"><%= h.language %></p>
      <%- renderLanguageSwitcher('mobile-language-switcher') %>
    </section>
    <section class="mobile-nav-section" aria-labelledby="mobile-nav-appearance-label">
      <p id="mobile-nav-appearance-label" class="mobile-nav-label"><%= h.appearance %></p>
      <button class="theme-toggle theme-toggle--mobile" type="button" data-theme-toggle aria-label="<%= h.toggleTheme %>" aria-pressed="false">
        <span class="theme-toggle__icon" aria-hidden="true"></span>
        <span class="theme-toggle__label"><small>Theme</small><strong data-theme-label><%= h.dark %></strong></span>
      </button>
    </section>
  </nav>
</header>

<script>
  (function() {
    var storageKey = 'seraph-theme';
    var root = document.documentElement;
    var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-theme-toggle]'));
    var labels = Array.prototype.slice.call(document.querySelectorAll('[data-theme-label]'));
    var lightLabel = '<%= h.light %>';
    var darkLabel = '<%= h.dark %>';

    function applyTheme(theme) {
      var nextTheme = theme === 'light' ? 'light' : 'dark';
      root.setAttribute('data-theme', nextTheme);
      buttons.forEach(function(button) {
        button.setAttribute('aria-pressed', String(nextTheme === 'dark'));
        button.setAttribute('aria-label', '<%= h.toggleTheme %>: ' + (nextTheme === 'light' ? lightLabel : darkLabel));
        button.setAttribute('title', nextTheme === 'light' ? lightLabel : darkLabel);
      });
      labels.forEach(function(label) {
        label.textContent = nextTheme === 'light' ? lightLabel : darkLabel;
      });
    }

    try {
      applyTheme(localStorage.getItem(storageKey) || 'dark');
    } catch (error) {
      applyTheme('dark');
    }

    buttons.forEach(function(button) {
      button.addEventListener('click', function() {
        var nextTheme = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        applyTheme(nextTheme);
        try {
          localStorage.setItem(storageKey, nextTheme);
        } catch (error) {
          return;
        }
      });
    });

    var menuButton = document.querySelector('.mobile-menu-button');
    var menu = document.getElementById('mobile-nav');
    var header = document.querySelector('.site-header');

    function closeMenu() {
      if (!menuButton || !menu) return;
      menuButton.setAttribute('aria-expanded', 'false');
      menu.hidden = true;
    }

    function updateHeaderState() {
      if (!header) return;
      header.classList.toggle('is-scrolled', window.scrollY > 12);
    }

    updateHeaderState();
    window.addEventListener('scroll', updateHeaderState, { passive: true });

    if (!menuButton || !menu) return;
    menuButton.addEventListener('click', function() {
      var isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isOpen));
      menu.hidden = isOpen;
    });
    menu.addEventListener('click', function(event) {
      if (event.target && event.target.closest('a')) closeMenu();
    });
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') closeMenu();
    });
  })();
</script>
