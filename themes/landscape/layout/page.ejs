<%
  const normalizedPagePath = String(page.path || '').replace(/index\.html$/, '').replace(/\/$/, '');
  const pageParts = normalizedPagePath.split('/').filter(Boolean);
  const normalizePageLang = function(value) {
    const normalized = String(value || '').toLowerCase();
    if (normalized === 'zh' || normalized === 'zh-tw' || normalized === 'zh-hant') return 'zh';
    if (normalized === 'en') return 'en';
    return '';
  };
  const explicitPageLang = ['en', 'zh'].includes(pageParts[0]) ? pageParts[0] : '';
  const pageLang = explicitPageLang || normalizePageLang(page.site_lang) || 'en';
  const localPageParts = explicitPageLang ? pageParts.slice(1) : pageParts;
  const pageSection = localPageParts[0] || 'home';
  const pageType = String(page.type || '').toLowerCase();
  const isIaPage = pageType === 'ia';
  const isSystemDetail = pageType === 'system' || pageType === 'system-detail' || Boolean(page.system);
  const isProjectDetail = String(page.type || '').toLowerCase() === 'project' || (pageSection === 'projects' && localPageParts.length === 2);
  const isExperienceLanding = pageSection === 'experience' && localPageParts.length === 1;
  const isExperienceDetail = pageSection === 'experience' && localPageParts.length === 2;
  const isContactLanding = pageSection === 'contact' && localPageParts.length === 1;
  const i18nPagePaths = [
    '',
    'dashboard',
    'projects',
    'outcomes',
    'now',
    'labs',
    'writing',
    'timeline',
    'en',
    'en/projects',
    'en/outcomes',
    'en/now',
    'en/experience',
    'zh',
    'zh/dashboard',
    'zh/projects',
    'zh/outcomes',
    'zh/now',
    'zh/labs',
    'zh/writing',
    'zh/timeline'
  ];
  const isI18nPage = i18nPagePaths.includes(normalizedPagePath);
  const pageCopy = {
    en: {
      pageKicker: 'Notebook Page',
      searchPlaceholder: 'Search posts...',
      searchLoadFailed: 'Failed to load search index.',
      searchHint: 'Type something to search.',
      searchEmpty: 'No matching posts found.',
      untitled: 'Untitled'
    },
    zh: {
      pageKicker: '頁面',
      searchPlaceholder: '搜尋文章...',
      searchLoadFailed: '無法載入搜尋索引。',
      searchHint: '輸入關鍵字開始搜尋。',
      searchEmpty: '找不到符合的文章。',
      untitled: '未命名'
    }
  }[pageLang] || {
    pageKicker: 'Notebook Page',
    searchPlaceholder: 'Search posts...',
    searchLoadFailed: 'Failed to load search index.',
    searchHint: 'Type something to search.',
    searchEmpty: 'No matching posts found.',
    untitled: 'Untitled'
  };

  const projectFactLabels = {
    en: { year: 'Year', period: 'Period', status: 'Status', role: 'Role', category: 'Category', repository: 'Repository', demo: 'Demo' },
    zh: { year: '年份', period: '期間', status: '狀態', role: '角色', category: '分類', repository: 'Repository', demo: 'Demo' }
  }[pageLang] || {};

  const projectFacts = [
    ['year', page.year],
    ['period', page.period],
    ['status', page.status],
    ['role', page.role],
    ['category', page.category],
    ['repository', page.repository],
    ['demo', page.demo]
  ].filter(function(item) { return item[1]; });

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function textFromHtml(markup) {
    return String(markup || '').replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
  }

  function stripDuplicateProjectLead(markup, title) {
    let next = String(markup || '').trimStart();
    next = next.replace(/^<section\s+class="project-page-hero"[^>]*>[\s\S]*?<\/section>\s*/i, '');
    next = next.replace(/^<h1\b[^>]*>[\s\S]*?<\/h1>\s*/i, function(match) {
      return textFromHtml(match) === String(title || '').trim() ? '' : match;
    });
    return next;
  }

  function renderProjectFactValue(key, value) {
    const text = escapeHtml(value);
    if ((key === 'repository' || key === 'demo') && /^https?:\/\//i.test(String(value || ''))) {
      return '<a href="' + text + '" rel="noopener noreferrer">' + text + '</a>';
    }
    return text;
  }

  function transformProjectTechList(markup) {
    return String(markup || '').replace(/(<h2\b[^>]*>[\s\S]*?(?:Built with|使用技術)[\s\S]*?<\/h2>)\s*<p>([^<]+)<\/p>/gi, function(match, heading, rawTech) {
      const items = textFromHtml(rawTech)
        .split(/\s+繚\s+|\s+\|\s+|\s*,\s*/)
        .map(function(item) { return item.trim(); })
        .filter(Boolean);
      if (!items.length) return match;
      return heading + '<ul class="project-tech-list">' + items.map(function(item) {
        return '<li>' + escapeHtml(item) + '</li>';
      }).join('') + '</ul>';
    });
  }

  const projectBody = transformProjectTechList(stripDuplicateProjectLead(page.content, page.title));
  const iaBody = String(page.content || '')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&#039;/g, "'")
    .replace(/&amp;/g, '&');
%>

<% if (isExperienceLanding) { %>
  <%- partial('_partial/experience-page') %>
<% } else if (isContactLanding) { %>
  <%- page.content %>
<% } else if (isExperienceDetail) { %>
  <%- partial('_partial/experience-detail') %>
<% } else if (isSystemDetail) { %>
  <%- partial('_partial/system-detail') %>
<% } else if (isProjectDetail) { %>
  <article class="project-detail" lang="<%= pageLang === 'zh' ? 'zh-Hant' : 'en' %>">
    <header class="project-detail__hero">
      <p class="project-detail__eyebrow">PROJECT CASE STUDY</p>
      <h1 class="project-detail__title"><%= page.title %></h1>
      <% if (page.summary || page.description) { %>
        <p class="project-detail__summary"><%= page.summary || page.description %></p>
      <% } %>
      <% if (projectFacts.length) { %>
        <dl class="project-detail__facts">
          <% projectFacts.forEach(function(fact) { %>
            <div>
              <dt><%= projectFactLabels[fact[0]] || fact[0] %></dt>
              <dd><%- renderProjectFactValue(fact[0], fact[1]) %></dd>
            </div>
          <% }) %>
        </dl>
      <% } %>
    </header>

    <div class="project-detail__body">
      <%- projectBody %>
    </div>
  </article>
<% } else if (isIaPage) { %>
  <article class="page-content notebook-page ia-shell">
    <div class="page-body">
      <%- iaBody %>
    </div>
  </article>
<% } else if (isI18nPage) { %>
  <%- partial('_partial/i18n-page') %>
<% } else { %>
  <article class="page-content notebook-page">
    <header class="page-header">
      <div class="page-kicker"><%= pageCopy.pageKicker %></div>
      <h1 class="section-title"><%= page.title %></h1>
    </header>

    <div class="page-body">
      <% if (page.title === 'Search') { %>
        <div class="search-box-wrap">
          <input id="local-search-input" class="search-input" type="text" placeholder="<%= pageCopy.searchPlaceholder %>" autocomplete="off" />
          <div id="local-search-results" class="search-results"></div>
        </div>

        <script>
          (async function () {
            const input = document.getElementById('local-search-input');
            const results = document.getElementById('local-search-results');
            let posts = [];

            try {
              const res = await fetch('<%= url_for('/search.json') %>');
              posts = await res.json();
            } catch (err) {
              results.innerHTML = '<p><%= pageCopy.searchLoadFailed %></p>';
              return;
            }

            function escapeHtml(str) {
              return String(str || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
            }

            function stripHtml(html) {
              const div = document.createElement('div');
              div.innerHTML = html;
              return div.textContent || div.innerText || '';
            }

            function highlight(text, keyword) {
              if (!keyword) return escapeHtml(text);
              const escaped = escapeHtml(text);
              const pattern = new RegExp(`(${keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'ig');
              return escaped.replace(pattern, '<mark>$1</mark>');
            }

            function normalizeSearchUrl(url) {
              const value = String(url || '/');
              if (/^https?:\/\//i.test(value)) return value;
              return value.replace(/^\/+/, '/');
            }

            function renderResults(list, keyword) {
              if (!keyword.trim()) {
                results.innerHTML = '<p class="search-hint"><%= pageCopy.searchHint %></p>';
                return;
              }

              if (!list.length) {
                results.innerHTML = '<p class="search-empty"><%= pageCopy.searchEmpty %></p>';
                return;
              }

              results.innerHTML = list.map(post => {
                const rawText = stripHtml(post.content || '');
                const excerpt = rawText.slice(0, 180);
                return `
                  <article class="search-result-item">
                    <div class="search-result-date">${post.date ? post.date.slice(0, 10) : ''}</div>
                    <div class="search-result-main">
                      <a class="search-result-title" href="${normalizeSearchUrl(post.url)}">${highlight(post.title || '<%= pageCopy.untitled %>', keyword)}</a>
                      <p class="search-result-excerpt">${highlight(excerpt, keyword)}...</p>
                    </div>
                  </article>
                `;
              }).join('');
            }

            input.addEventListener('input', function () {
              const keyword = this.value.toLowerCase().trim();
              const matched = posts.filter(post => {
                const title = (post.title || '').toLowerCase();
                const content = stripHtml(post.content || '').toLowerCase();
                return title.includes(keyword) || content.includes(keyword);
              });
              renderResults(matched, this.value.trim());
            });

            renderResults([], '');
          })();
        </script>
      <% } else { %>
        <%- page.content %>
      <% } %>
    </div>
  </article>
<% } %>
